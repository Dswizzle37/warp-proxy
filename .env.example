# Copy to .env and edit (all optional).

# Your server's public IPv4. Auto-detected if left blank.
PUBLIC_IP=

# Always allow certificates for these domains and their subdomains,
# even if DNS doesn't point straight at this server (e.g. behind Cloudflare's orange cloud).
# Example: MIRROR_DOMAINS=mooo.com,example.org
MIRROR_DOMAINS=

# DNS resolvers the proxy uses. Default is Cloudflare's family filter.
# DNS_SERVERS=1.1.1.3,1.0.0.3
